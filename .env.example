APP_NAME="Aaron's Adventures"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# On Laravel Cloud use "cache" + "database" so a `php artisan down` is seen by
# every replica instead of only the one that handled the command.
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# SQLite is fine locally. In production attach a Postgres or MySQL database;
# the instance filesystem is wiped on every deploy, so a SQLite file would be
# a brand new empty database each time.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

ANTHROPIC_API_KEY=
# claude | scripted — "scripted" plays offline with a stand-in narrator.
QUESTCAST_DM_DRIVER=claude
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_EFFORT=medium

ELEVENLABS_API_KEY=
# elevenlabs | silent — "silent" plays the game without reading it aloud.
QUESTCAST_NARRATOR_DRIVER=elevenlabs
# Run `php artisan narrator:voices` to find one that sounds like your storyteller.
ELEVENLABS_VOICE_ID=

# Where player selfies and the spoken story live. Use object-storage disks in
# production: app instances have an ephemeral filesystem.
PORTRAIT_DISK=public
NARRATION_DISK=public

# "log" keeps local play quiet. Production must be "reverb" or no phone at the
# table ever hears about a new scene.
BROADCAST_CONNECTION=log

# Injected automatically when a WebSocket cluster is attached on Laravel Cloud.
# The VITE_ copies are read by resources/js/echo.js and are baked into the
# bundle at build time, so they must be present when `npm run build` runs.
# REVERB_APP_ID=
# REVERB_APP_KEY=
# REVERB_APP_SECRET=
# REVERB_HOST=
# REVERB_PORT=443
# REVERB_SCHEME=https
# VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
# VITE_REVERB_HOST="${REVERB_HOST}"
# VITE_REVERB_PORT="${REVERB_PORT}"
# VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Also the disk Livewire stages file uploads on. A selfie is uploaded in one
# request and processed in the next, which may land on a different instance,
# so this has to be shared storage once there is more than one replica.
FILESYSTEM_DISK=local

QUEUE_CONNECTION=database

# Must stay above the 180s timeout on the dungeon master jobs, or a slow scene
# is handed to a second worker while the first is still writing it.
DB_QUEUE_RETRY_AFTER=300

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Injected when an object storage bucket is attached, except AWS_URL, which has
# to be copied from the bucket settings page by hand. Without it, portrait URLs
# point at the application instead of the bucket.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
